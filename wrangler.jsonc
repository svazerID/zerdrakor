{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zerdrakor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Variables / secrets are NOT committed here. Set them in the dashboard
  // (Workers -> Settings -> Variables) or with `wrangler secret put`:
  //   APP_URL          -> real production host, e.g. https://drakor.svazer.us.ci
  //   DRAKOR_API_KEY   -> secret, from the gist the project uses (never commit it)
  //   DRAKOR_API_BASE  -> optional, defaults to https://kampretloh.top/v3
  "vars": {
    "APP_URL": "https://zerdrakor.workers.dev"
  }
}
