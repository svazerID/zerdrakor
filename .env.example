# ZerDrakor environment — semua variabel sekarang OPSIONAL.
#
# APP_URL: the public host of this deployment. Used for OG/canonical URLs.
# Local dev can leave it unset (defaults to http://localhost:3000).
# On Workers, set it in the dashboard to the real production host.
APP_URL="https://zerdrakor.workers.dev"

# DRAKOR_API_KEY: server-only key for the upstream JSON API used by
# lib/server/drakor-api.ts. Sudah ada fallback bawaan yang di-hardcode
# di file itu (key publik), jadi TIDAK WAJIB di-set — rebuild Workers
# tidak perlu set env var ulang. Set di sini/di dashboard hanya kalau
# key upstream diganti (env var selalu menang atas fallback).
DRAKOR_API_KEY=""

# DRAKOR_API_BASE: optional override, defaults to https://kampretloh.top/v3
# DRAKOR_API_BASE="https://kampretloh.top/v3"
